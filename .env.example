# 服务端口
PORT=3000

# 日志级别
LOG_LEVEL=info

# 数据库路径（相对于 server/）
DB_PATH=./data/muse-mail.db

# 访问密码（留空则不启用认证）
ACCESS_PASSWORD=

# 默认集成 Token（可选，写在你本地 .env，不要提交到仓库）
DEFAULT_GITHUB_TOKEN=
DEFAULT_CLOUDFLARE_TOKEN=
DEFAULT_NOTION_TOKEN=

# Gmail OAuth（前端读取；写在本地 .env.example，不提交到仓库）
VITE_GMAIL_CLIENT_ID=
VITE_GMAIL_CLIENT_SECRET=

# 线上部署时把这两个 Origin 改成你的正式域名
# 如果前后端同域部署，两者通常填一样即可
SERVER_ORIGIN=https://muse.y130.icu
WEB_APP_ORIGIN=https://muse.y130.icu

# Google OAuth 回调地址，默认自动使用 SERVER_ORIGIN/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://muse.y130.icu/api/oauth/google/callback
OPENAI_OAUTH_REDIRECT_URI=https://muse.y130.icu/api/oauth/openai/callback

# 后台 Google OAuth 登录（可选）
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
ADMIN_ALLOWED_EMAILS=admin@example.com
ADMIN_GOOGLE_OAUTH_REDIRECT_URI=https://muse.y130.icu/api/auth/google/callback
